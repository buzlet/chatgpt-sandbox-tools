{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatgpt-http-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_STATE",
        "class_name": "RelayState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayState"]
    }
  ]
}
